{
  "uid": "fraud-detection",
  "title": "Fraud Detection",
  "tags": ["fraud-detection"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Transactions Scored Per Second",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(flink_taskmanager_job_task_operator_alerts_total[1m])",
          "legendFormat": "scored/s",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        }
      }
    },
    {
      "id": 2,
      "title": "Decision Breakdown",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "flink_taskmanager_job_task_operator_alerts_approve",
          "legendFormat": "APPROVE",
          "refId": "A"
        },
        {
          "expr": "flink_taskmanager_job_task_operator_alerts_review",
          "legendFormat": "REVIEW",
          "refId": "B"
        },
        {
          "expr": "flink_taskmanager_job_task_operator_alerts_decline",
          "legendFormat": "DECLINE",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "APPROVE" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "REVIEW" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "DECLINE" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "pieType": "donut"
      }
    },
    {
      "id": 3,
      "title": "Triggered Rules by Type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(flink_taskmanager_job_task_operator_rules_velocity_triggered[1m])",
          "legendFormat": "Velocity",
          "refId": "A"
        },
        {
          "expr": "rate(flink_taskmanager_job_task_operator_rules_geo_anomaly_triggered[1m])",
          "legendFormat": "Geo Anomaly",
          "refId": "B"
        },
        {
          "expr": "rate(flink_taskmanager_job_task_operator_rules_amount_anomaly_triggered[1m])",
          "legendFormat": "Amount Anomaly",
          "refId": "C"
        },
        {
          "expr": "rate(flink_taskmanager_job_task_operator_rules_card_testing_triggered[1m])",
          "legendFormat": "Card Testing",
          "refId": "D"
        },
        {
          "expr": "rate(flink_taskmanager_job_task_operator_rules_blacklist_triggered[1m])",
          "legendFormat": "Blacklist",
          "refId": "E"
        },
        {
          "expr": "rate(flink_taskmanager_job_task_operator_rules_model_high_risk_triggered[1m])",
          "legendFormat": "Model High Risk",
          "refId": "F"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        }
      }
    },
    {
      "id": 4,
      "title": "Decision Rate Over Time",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "rate(flink_taskmanager_job_task_operator_alerts_approve[1m])",
          "legendFormat": "APPROVE/s",
          "refId": "A"
        },
        {
          "expr": "rate(flink_taskmanager_job_task_operator_alerts_review[1m])",
          "legendFormat": "REVIEW/s",
          "refId": "B"
        },
        {
          "expr": "rate(flink_taskmanager_job_task_operator_alerts_decline[1m])",
          "legendFormat": "DECLINE/s",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "APPROVE/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "REVIEW/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "yellow", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "DECLINE/s" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 5,
      "title": "Pipeline Consumer Lag",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum by (topic) (kafka_consumergroup_lag{consumergroup=~\"flink.*\"})",
          "legendFormat": "{{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 },
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 1000 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "Total Reviews",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "flink_taskmanager_job_task_operator_alerts_review",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "yellow", "value": null }
            ]
          }
        }
      }
    },
    {
      "id": 7,
      "title": "Review + Decline Rate",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "(flink_taskmanager_job_task_operator_alerts_review + flink_taskmanager_job_task_operator_alerts_decline) / clamp_min(flink_taskmanager_job_task_operator_alerts_total, 1)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.15 }
            ]
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Pipeline Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_numRecordsOut{operator_name=~\".*Source.*\"}[1m]))",
          "legendFormat": "Source Input",
          "refId": "A"
        },
        {
          "expr": "sum(rate(flink_taskmanager_job_task_operator_numRecordsIn{operator_name=~\".*Sink.*\"}[1m]))",
          "legendFormat": "Sink Output",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 2 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Source Input" }, "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Sink Output" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "id": 9,
      "title": "Total Transactions Scored",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "flink_taskmanager_job_task_operator_alerts_total",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Total Declines",
      "type": "stat",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "expr": "flink_taskmanager_job_task_operator_alerts_decline",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  }
}